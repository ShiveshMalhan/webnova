    <!-- SHOPPING CART -->
    <div class="cart-overlay" id="cart-overlay" onclick="toggleCart()">
        <div class="cart-panel" onclick="event.stopPropagation()">

            <div class="cart-header">
                <h2>Your Shopping Bag</h2>
                <button class="close-cart" onclick="toggleCart()" aria-label="Close cart">×</button>
            </div>

            <div id="cart-items">
                <p class="empty-cart">Your shopping bag is empty.</p>
            </div>

            <div class="cart-footer">
                <div class="cart-total">
                    <span>Total</span>
                    <span id="cart-total">₹0</span>
